# ---- Mode ----------------------------------------------------------------
# DRY_RUN=true (default) never signs or sends anything. Set to false ONLY after
# you have funded the agent wallet and reviewed policy.json.
DRY_RUN=true

# ---- Solana ----------------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Path to the agent keypair created by `npm run keygen` (gitignored).
AGENT_KEYPAIR_PATH=.secrets/agent-keypair.json
# Optional: watch a different wallet (e.g. your Steve Capital agent wallet) in read-only mode.
WATCH_WALLET=

# ---- OOBE SAP MCP (hosted, free read tools need no key) --------------------
SAP_MCP_URL=https://mcp.sap.oobeprotocol.ai/mcp

# ---- Jupiter ---------------------------------------------------------------
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1

# ---- MultiHopper side track (optional) -------------------------------------
# Get a key at multihopper.com (mh_test_ for devnet, mh_live_ for mainnet).
MULTIHOPPER_API_KEY=
MULTIHOPPER_API_BASE=https://multihopper.com/api/v1
# Real recipient(s) for profit distribution, comma separated. Must NOT be your
# own wallets: self/circular transfers are excluded by the bounty rules.
MULTIHOPPER_RECIPIENTS=

# ---- Ace Data Cloud side track (optional) ----------------------------------
# Must be backed by PURCHASED credits to count for the side track.
ACE_API_KEY=
ACE_API_BASE=https://api.acedata.cloud
